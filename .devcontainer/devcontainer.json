// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "C++",
	"build": {
		"dockerfile": "../ci/docker/docker_files/Dockerfile",
		"target": "cit",
		"args": {
			"BUILDKIT_INLINE_CACHE": "1"
		}
	},
	"runArgs": [
		"--privileged",
		"--network=host",
		"--dns=8.8.4.4",
		"--dns-opt=nameserver 8.8.8.8"
	],
	"containerEnv": {
    	"DISPLAY": "${localEnv:DISPLAY}"
	},
	// Use this mounts in windows host.
	"mounts": [
		{
			
			"source": "E:/builds_temp_data/.conan2",
			"target": "/home/ubuntu/.conan2",
			"type": "bind"
		},
		{
			"source": "E:/builds_temp_data/.cache",
			"target": "/home/ubuntu/.cache",
			"type": "bind"
		}
	],
	// Use this mounts in linux host.
	// "mounts": [
	// 	{
	// 		"source": "/home/user/.conan2",
	// 		"target": "/home/ubuntu/.conan2",
	// 		"type": "bind"
	// 	},
	// 	{
	// 		"source": "/home/user/.cache",
	// 		"target": "/home/ubuntu/.cache",
	// 		"type": "bind"
	// 	}
	// ],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools-extension-pack",
				"eamodio.gitlens",
				"Codeium.codeium",
				"ms-azuretools.vscode-docker",
				"disroop.conan",
				"Gruntfuggly.todo-tree",
				"vadimcn.vscode-lldb",
				// TODO(melg): add integration with code coverage reports.
				"ryanluker.vscode-coverage-gutters"
			]
		}
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
    	"ghcr.io/devcontainers/features/desktop-lite:1": {}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [5901],
	"portsAttributes": {
	  "5901": {
		"label": "vnc"
	  }
	}
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "gcc -v",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}