{
    "namespaceReplacements":
    {
        "std": "",
        "__cxx..": "cxx",
        "boost::hana": "bh",
        "boost::fusion": "bf",
        "boost::spirit": "bs",
        "boost::beast": "bst",
        "boost::asio": "net",
        "boost::cobalt": "co",
        "impl": "_",
        "implementation": "_",
        "detail": "_"
    },
    "genericReplacements":
    {
        "integral_constant": "ic",
        "lambda\\(": "[?](",
        "size_t": "sz_t",
        "unsigned ": "u",
        "long unsigned": "ul",
        "unsigned long": "ul",
        "type_impl": "type",
        "tag_impl": "tag",
        "forward": "fwd"
    }
}